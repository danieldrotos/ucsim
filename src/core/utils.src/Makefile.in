PKG		= ucsimutil

include ../../common.mk

srcdir          = @srcdir@
VPATH           = @srcdir@

top_builddir	= @top_builddir@
top_srcdir	= @top_srcdir@


# Compiling entire program or any subproject
# ------------------------------------------
all: prep libs

prep: $(srcdir)/version.h

include $(top_srcdir)/src/lib.mk

$(srcdir)/version.h: $(top_srcdir)/.version
	$(SED) 's/^/#define VERSIONSTR "/' $?|$(SED) 's/$$/"/' >$@


# Performing self-test
# --------------------
check:

test:

baseline:


# End of utils.src/Makefile
